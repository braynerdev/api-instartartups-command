<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Instartups.Infrastructure\Instartups.Infrastructure.csproj" />
  </ItemGroup>


  <Target Name="husky" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != 0">
	<Exec Command="dotnet tool restore" StandardOutputImportance="Low" />
	<Exec Command="dotnet husky install" StandardOutputImportance="Low" WorkingDirectory="../.." />
  </Target>

</Project>
